# 复制为 .env 后按需修改；不复制则使用默认值
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=qms
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qingyuan-qms
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
BACKEND_PORT=8080
FRONTEND_PORT=80
# 必填：JWT 签名密钥，随机字符串且 >= 32 字节；生产环境切勿使用示例值。
# 生成方式（任选其一）：
#   PowerShell : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
#   Bash      : openssl rand -base64 48
QMS_JWT_SECRET=
